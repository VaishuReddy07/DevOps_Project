# Flask Environment
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# MySQL Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
